Dialogue: 0,0:00:00.00,0:00:00.96,Sub,,0,0,0,,En el fondo del mar
Dialogue: 0,0:00:00.96,0:00:01.86,Sub,,0,0,0,,vive un animal del
Dialogue: 0,0:00:01.86,0:00:02.92,Sub,,0,0,0,,tamaño de un dedo que
Dialogue: 0,0:00:02.92,0:00:03.72,Sub,,0,0,0,,dispara… con una
Dialogue: 0,0:00:03.72,0:00:04.02,Sub,,0,0,0,,pinza.
Dialogue: 0,0:00:04.17,0:00:05.19,Sub,,0,0,0,,El camarón pistola
Dialogue: 0,0:00:05.19,0:00:06.27,Sub,,0,0,0,,cierra su pinza tan
Dialogue: 0,0:00:06.27,0:00:07.34,Sub,,0,0,0,,rápido que lanza un
Dialogue: 0,0:00:07.34,0:00:08.59,Sub,,0,0,0,,chorro de agua y forma
Dialogue: 0,0:00:08.59,0:00:09.27,Sub,,0,0,0,,una burbuja.
Dialogue: 0,0:00:09.42,0:00:10.66,Sub,,0,0,0,,Y cuando esa burbuja
Dialogue: 0,0:00:10.66,0:00:11.85,Sub,,0,0,0,,revienta, suelta un
Dialogue: 0,0:00:11.85,0:00:12.91,Sub,,0,0,0,,destello de luz y
Dialogue: 0,0:00:12.91,0:00:14.09,Sub,,0,0,0,,alcanza, durante un
Dialogue: 0,0:00:14.09,0:00:15.34,Sub,,0,0,0,,instante, unos cinco
Dialogue: 0,0:00:15.34,0:00:16.02,Sub,,0,0,0,,mil grados.
Dialogue: 0,0:00:16.17,0:00:17.55,Sub,,0,0,0,,Casi la temperatura de
Dialogue: 0,0:00:17.55,0:00:18.94,Sub,,0,0,0,,la superficie del Sol.
Dialogue: 0,0:00:18.94,0:00:19.88,Sub,,0,0,0,,Un disparo… sin
Dialogue: 0,0:00:19.88,0:00:20.38,Sub,,0,0,0,,pólvora.
Dialogue: 0,0:00:20.53,0:00:21.13,Sub,,0,0,0,,Tienes once
Dialogue: 0,0:00:21.13,0:00:22.31,Sub,,0,0,0,,curiosidades más en la
Dialogue: 0,0:00:22.31,0:00:23.23,Sub,,0,0,0,,dosis completa de
Dialogue: 0,0:00:23.23,0:00:23.93,Sub,,0,0,0,,Shock Mental.
